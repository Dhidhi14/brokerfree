# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/brokerfree

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Client (CORS)
CLIENT_URL=http://localhost:5173

# Cloudinary (optional — media uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Razorpay (optional — payments)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# Anthropic (optional — AI video verification)
# ANTHROPIC_API_KEY=

# Redis (optional — caching / BullMQ)
# REDIS_URL=redis://localhost:6379
